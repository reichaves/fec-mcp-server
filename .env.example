# OpenFEC API key (Required)
# Get your key for free at: https://api.data.gov/signup/
FEC_API_KEY=your_api_key_here

# OpenFEC API base URL (Optional)
# Default: https://api.open.fec.gov/v1
# FEC_API_BASE_URL=https://api.open.fec.gov/v1

# MCP server output language (Optional)
# Supported values: en (English), pt (Portuguese)
# Default: en
# FEC_MCP_LANG=pt



# FEC_API_KEY: Variável obrigatória para acessar a API do OpenFEC.
# FEC_API_BASE_URL: Opcional, para caso a URL base da API mude no futuro.
# FEC_MCP_LANG: Opcional, para definir o idioma das saídas do servidor (inglês ou português).

# FEC_API_KEY: A required variable for accessing the OpenFEC API.
# FEC_API_BASE_URL: Optional, in case the API base URL changes in the future.
# FEC_MCP_LANG: Optional, to set the language of the server’s output (English or Portuguese).